  {
   "name": "graded",
   "note": "linear gain: grade 2 at rank 2, grade 1 at rank 1 (NFCorpus has grade 2)",
   "qrels": {
    "q1": {
     "d1": 2,
     "d2": 1,
     "d3": 0
    }
   },
   "run": {
    "q1": [
     "d2",
     "d1",
     "d3",
     "d4"
    ]
   },
   "expected": {
    "per_query": {
     "q1": {
      "ndcg_10": 0.8597186998521972,
      "recall_100": 1.0
     }
    },
    "scored_queries": 1,
    "dropped_identical": 0,
    "mean_ndcg_10": 0.8597186998521972,
    "mean_recall_100": 1.0,
    "beir_rounded": {
     "ndcg_10": 0.85972,
     "recall_100": 1.0
    }
   }
  },
  {
