target/

# Python reference generator (Constitution §II goldens) — see reference/
reference/.venv-*/
__pycache__/
*.py[cod]

# Pinned model weights: 87.1 MiB, downloaded by gen_001_fixtures.py (001) and
# scripts/fetch-model.sh (004), NEVER committed. reference/fixtures/ IS tracked — those are the
# goldens — and so is reference/models/manifest.json, the pins the fetch script verifies against.
reference/models/*
!reference/models/manifest.json
!reference/models/manifest-rerank.json
*.safetensors

# uniffi bindgen output (quickstart Step 3)
/build/

# macOS / Xcode
.DS_Store
DerivedData/
xcuserdata/
*.xcuserstate
*.xcarchive
*.ipa

# iOS package build outputs — regenerate with scripts/build-ios-package.sh. Generated from the
# Rust (the XCFramework alone is ~260 MB), so committing them would create a second source of
# truth; the staged resources are models and indexes that are pinned elsewhere.
swift/Xtriever/Frameworks/
swift/Xtriever/Sources/Xtriever/Generated/
swift/Xtriever/Sources/Xtriever/XtrieverData/
swift/Xtriever/Tests/Fixtures/index/
swift/Xtriever/.build/
swift/XtrieverHarnessApp/XtrieverHarnessApp.xcodeproj/
build/

# BEIR evaluation datasets: ~23 MB fetched by scripts/fetch-beir.sh, pinned by hash in
# reference/datasets/beir-manifest.json, never committed (Feature 003 FR-008).
reference/datasets/beir/

# Simple English Wikipedia snapshot (Feature 008): 157 MB parquet + ~300 MB JSONL fetched by
# scripts/fetch-wiki.sh, pinned by hash in reference/datasets/wiki-manifest.json, never
# committed. The built index (target/xt-wiki*) and its embedding cache are under target/; the
# staged copy lives under swift/Xtriever/Sources/Xtriever/XtrieverData/ (already ignored above).
reference/datasets/wiki/

# Feature 009 demo app: the Xcode project is generated by scripts/build-ios-package.sh --demo.
apps/ios-wiki-demo/*.xcodeproj/
